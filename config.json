{
    "app_settings": {
        "window_size": "960x700",
        "max_commits": 50,
        "temp_dir_prefix": "gitdiff_",
        "default_target_dir": "",
        "export_mode": "changed_only",
        "generate_patch": true,
        "generate_summary": true
    },
    "git_settings": {
        "custom_git_path": "",
        "clone_timeout": 300,
        "fetch_all_branches": true,
        "ignore_patterns": [
            ".git",
            "__pycache__",
            "*.pyc",
            ".DS_Store",
            "Thumbs.db",
            "node_modules",
            ".venv"
        ]
    },
    "ui_settings": {
        "theme": "clean_light",
        "font_family": "Segoe UI",
        "font_size": 10,
        "auto_cleanup": true,
        "external_diff_tool": "code"
    }
}